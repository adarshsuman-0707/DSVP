# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# SQL Server (SSMS) connection
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_SERVER=localhost
DB_NAME=DSVP_DB
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Payments (fill when integrating)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Settings → Webhooks → set the same secret there
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173,https://candid-capybara-f87685.netlify.app

# Email (Gmail SMTP — for OTP / forgot password)
# Use a Gmail App Password (not your real password)
# Enable: Google Account → Security → 2FA → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="DSVP Platform <your_gmail@gmail.com>"

# OTP settings
OTP_EXPIRES_MIN=10
