# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# SQL Server (SSMS) connection
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_SERVER=localhost
DB_NAME=DSVP_DB
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Payments (fill when integrating)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Settings → Webhooks → set the same secret there
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173,https://candid-capybara-f87685.netlify.app

# Email (Gmail SMTP — for OTP / forgot password)
# Use a Gmail App Password (not your real password)
# Enable: Google Account → Security → 2FA → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="DSVP Platform <your_gmail@gmail.com>"

# OTP settings
OTP_EXPIRES_MIN=10

# ── Google sign-in (ID-token + nonce flow; no client secret needed) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_NONCE_TTL_MIN=5

# ── Temporary password / password policy ──
TEMP_PASSWORD_EXPIRES_MIN=60
PASSWORD_MIN_LENGTH=12

# ── Auth rate limits (per window) ──
AUTH_RATE_WINDOW_MIN=15
LOGIN_RATE_MAX=10
GOOGLE_RATE_MAX=30
CHANGE_PASSWORD_RATE_MAX=5

# ── Password policy (see database/19_password_policy.sql) ──
PASSWORD_MAX_LENGTH=128
PASSWORD_HISTORY_COUNT=5
# Breach check via HIBP k-anonymity range API: on (fail-open) | strict (fail-closed) | off
PASSWORD_BREACH_CHECK=on
PASSWORD_BREACH_THRESHOLD=1
PASSWORD_BREACH_TIMEOUT_MS=3000
BCRYPT_ROUNDS=12
OTP_SEND_RATE_MAX=5
OTP_VERIFY_RATE_MAX=10
RESET_PASSWORD_RATE_MAX=10

# ── Heap module execution limits (all optional) ──
# Raw trace events a run may emit before the trace is cut (the program still runs to completion)
DSVP_HEAP_MAX_RAW_EVENTS=40000
# Program input accepted by POST /api/execution/run `stdin`
DSVP_MAX_STDIN_BYTES=16384
