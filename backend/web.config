<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- iisnode hosts and manages the Node process; entry point is server.js -->
    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Don't rewrite requests for iisnode-owned debugging/logging paths -->
        <rule name="iisnode-debug" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^src/server.js/debug[/]?" />
        </rule>

        <!-- All other requests go straight to the Node app -->
        <rule name="DSVP-API" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="/*" />
          <action type="Rewrite" url="src/server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode-specific settings -->
    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      watchedFiles="*.js;web.config;.env"
      loggingEnabled="true"
      logDirectory="iisnode-logs"
      devErrorsEnabled="false"
    />

    <!-- Keep secrets/log/build artifacts out of the response surface -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="iisnode-logs" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
